APP_NAME="Smart Classroom Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================================
# DATABASE – Neon PostgreSQL
# Lấy từ Dashboard Neon > Project > Connection Details
# =============================================================
DB_CONNECTION=pgsql
DB_HOST=ep-xxx-xxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# =============================================================
# CORS – Cho phép Frontend (Vercel) gọi API
# Thay bằng link Vercel thực tế sau khi deploy, ví dụ:
#   FRONTEND_URL=https://smart-classroom-fe.vercel.app
# =============================================================
FRONTEND_URL=*

# =============================================================
# CLOUDINARY – Lưu ảnh và file tài liệu lên đám mây
# Lấy từ Cloudinary Dashboard > Settings > API Keys
# =============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
